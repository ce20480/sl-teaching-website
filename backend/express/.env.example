# Port for the Express server (default: 4000, aligns with frontend proxy)
PORT=4000

# URL of the Python backend API (ensure this is reachable)
PYTHON_API_URL=http://localhost:8000/api

# Node environment (usually 'development' for local work)
NODE_ENV=development

# Allowed CORS origin (URL of the frontend)
# For multiple origins, separate with commas (no spaces): http://localhost:5173,http://localhost:5174
CORS_ORIGIN=http://localhost:5173 