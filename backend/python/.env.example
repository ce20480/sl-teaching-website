# === Essential Blockchain Configuration ===

# Private key for the wallet used for general Web3 interactions (e.g., sending transactions).
# REQUIRED. Must start with 0x.
# IMPORTANT: Keep this secure. Do not commit the actual key to version control.
WEB3_PRIVATE_KEY="0xYOUR_PRIMARY_PRIVATE_KEY"

# RPC endpoint URL for the target blockchain network.
# REQUIRED. Example for Filecoin Calibration testnet:
WEB3_PROVIDER_URL=https://api.calibration.node.glif.io/rpc/v1

# Chain ID of the target blockchain network.
# REQUIRED. Example for Filecoin Calibration testnet:
CHAIN_ID=314159

# --- Deployed Contract Addresses (Update after deployment) ---

# Deployed address of the main Achievement NFT contract (e.g., ASLTeaching / AchievementToken).
# REQUIRED after deployment.
TFIL_ACHIEVEMENT_CONTRACT_ADDRESS=0xYOUR_ACHIEVEMENT_CONTRACT_ADDRESS

# Deployed address of the XP Token (ERC20) contract.
# REQUIRED after deployment.
ERC20_XP_CONTRACT_ADDRESS=0xYOUR_ERC20_XP_TOKEN_CONTRACT_ADDRESS

# --- Core Service Configuration ---

# Path to the trained machine learning model file.
# REQUIRED. Ensure the file exists at this path relative to the backend/python directory.
MODEL_PATH="./models/your_model_file.pt"

# === Optional / Specific Feature Configuration ===

# Private key specifically for blockchain operations if different from WEB3_PRIVATE_KEY.
# If not set, WEB3_PRIVATE_KEY might be used implicitly depending on the code.
# Uncomment and set if you use a distinct key for specific contract interactions.
# BLOCKCHAIN_PRIVATE_KEY="0xYOUR_SEPARATE_BLOCKCHAIN_OPERATIONS_KEY"

# Private key specifically for a reward service/wallet, if different from WEB3_PRIVATE_KEY.
# Uncomment and set if applicable.
# REWARD_SERVICE_PRIVATE_KEY="0xYOUR_REWARD_SERVICE_PRIVATE_KEY"

# RPC endpoint URL specifically for Filecoin testnet, if different from WEB3_PROVIDER_URL.
# Primarily useful if supporting multiple networks simultaneously.
# Uncomment and set if needed.
# FILECOIN_TESTNET_RPC_URL=https://api.calibration.node.glif.io/rpc/v1

# The public address of the account that deployed the smart contracts.
# Useful for reference or owner checks. Obtain after deployment or derive from the deployer private key.
# Uncomment and set if needed.
# DEPLOYER_ADDRESS=0xYOUR_CONTRACT_DEPLOYER_ADDRESS

# Transaction hash related to the achievement contract deployment/setup.
# Useful for reference or verification.
# Uncomment and set if needed.
# TFIL_ACHIEVEMENT_HASH=0xYOUR_ACHIEVEMENT_RELATED_HASH

# Deployed address of the TFIL XP Token contract (potentially deprecated if ERC20_XP_CONTRACT_ADDRESS is primary).
# Check config.py usage. Uncomment and set if required.
# TFIL_XP_TOKEN_CONTRACT_ADDRESS=0xYOUR_TFIL_XP_TOKEN_CONTRACT_ADDRESS

# --- Akave / Decentralized Storage Configuration (Optional) ---
# Uncomment and configure if using Akave for storage.

# Address of the Akave node.
# NODE_ADDRESS=connect.akave.ai:5500

# Default bucket name for storage on Akave/Filecoin.
# DEFAULT_BUCKET=your-default-storage-bucket-name

# Host URL for the Akave service/API.
# AKAVE_HOST=http://localhost:4000 