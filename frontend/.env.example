# Get this from WalletConnect Cloud (https://cloud.walletconnect.com/)
VITE_WALLET_CONNECT_PROJECT_ID=YOUR_WALLET_CONNECT_PROJECT_ID

# The base URL for the backend API (Express Middleware)
# Should point to where the Express server is running.
VITE_API_BASE_URL=http://localhost:4000/api

# The deployed address of the main ASLTeaching smart contract (obtain after deploying contracts)
VITE_CONTRACT_ADDRESS=YOUR_MAIN_CONTRACT_ADDRESS

# The deployed address of the XP Token smart contract (obtain after deploying contracts)
VITE_XP_TOKEN_CONTRACT_ADDRESS=YOUR_XP_TOKEN_CONTRACT_ADDRESS

# Your Filecoin testnet address (e.g., Calibration testnet) used by the frontend (if needed directly)
# Ensure this aligns with backend/blockchain configuration if interaction is indirect.
# (Verify if this is still actively used in the frontend code)
# VITE_WALLET_FILECOIN_TESTNET=YOUR_FILECOIN_TESTNET_ADDRESS 