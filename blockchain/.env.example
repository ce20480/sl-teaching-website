# Private key for the account used to deploy contracts.
# Ensure this account has sufficient funds (e.g., test FIL) on the target network.
# IMPORTANT: Keep this secure. Do not commit the actual key to version control.
WEB3_PRIVATE_KEY="0xYOUR_DEPLOYER_PRIVATE_KEY"

# Optional: API key for automatic contract verification on block explorers (e.g., Etherscan, Filscan).
# Get this from the explorer website for the target network.
ETHERSCAN_API_KEY="YOUR_BLOCK_EXPLORER_API_KEY" 